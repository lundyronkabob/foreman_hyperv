<%= text_f f, :url, label: _("Hyper-V Host") %>

<%= text_f f, :user, label: _("Username") %>

<%= password_f f, :password, label: _("Password") %>

<%= field(f, :transport, label: _("Transport")) do %>
  <%= f.select :transport,
        [["HTTP", "plaintext"], ["HTTPS", "ssl"]],
        { selected: f.object.transport },
        class: "form-control" %>
<% end %>

<%= test_connection_button_f(f, f.object.connection_valid?) %>
